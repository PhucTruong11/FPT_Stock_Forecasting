# Môi trường ảo (Virtual Environments)
venv/
env/
.env

# Python Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.cache/

# Jupyter Notebook Caches
.ipynb_checkpoints/

# CSV sinh ra được bỏ qua; snapshot công khai có hash được lưu trong data/snapshots/.
data/raw/*.csv
data/interim/*.csv
data/processed/*.csv
data/processed/*.npy
data/backups/

# Weight mới mặc định bỏ qua; bộ CPU reference nhỏ được track có chủ đích.
models/**/*.h5
models/**/*.pkl
models/**/*.keras

# IDE settings
.vscode/
.idea/

# Ảnh legacy; biểu đồ benchmark v2 nằm trong reports/experiments/.
reports/figures/*.png
